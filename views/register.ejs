<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    * { margin:0; padding:0; box-sizing:border-box; }
    body {
      background: #0a0a0f;
      color: #f0f0f5;
      font-family: 'Inter', sans-serif;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 1.5rem;
    }
    .auth-card {
      background: rgba(18, 18, 35, 0.85);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 2.2rem;
      padding: 2.5rem 2rem;
      max-width: 400px;
      width: 100%;
      box-shadow: 0 30px 80px -20px rgba(0,0,0,0.6);
      animation: fadeUp 0.6s ease-out both;
      transform-style: preserve-3d;
      perspective: 600px;
      transition: transform 0.1s ease;
    }
    @keyframes fadeUp {
      from { opacity:0; transform: translateY(30px) scale(0.97); }
      to { opacity:1; transform: translateY(0) scale(1); }
    }
    .auth-title {
      font-size: 2rem;
      font-weight: 700;
      text-align: center;
      margin-bottom: 0.25rem;
      background: linear-gradient(135deg, #e94560, #ff6b6b);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
    }
    .auth-sub {
      text-align: center;
      opacity: 0.4;
      font-size: 0.85rem;
      margin-bottom: 1.8rem;
    }
    input {
      width: 100%;
      padding: 0.8rem 1.1rem;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 1rem;
      color: #f0f0f5;
      font-size: 1rem;
      outline: none;
      transition: all 0.2s ease;
      margin-bottom: 0.8rem;
    }
    input:focus {
      border-color: #e94560;
      box-shadow: 0 0 0 3px rgba(233,69,96,0.08);
    }
    input::placeholder { color: rgba(255,255,255,0.2); }
    .btn-primary {
      width: 100%;
      padding: 0.8rem;
      background: #e94560;
      border: none;
      border-radius: 1rem;
      color: #fff;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
      box-shadow: 0 4px 25px rgba(233,69,96,0.25);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
    }
    .btn-primary:hover {
      transform: translateY(-2px) scale(1.02);
      box-shadow: 0 8px 40px rgba(233,69,96,0.35);
    }
    .error-box {
      background: rgba(233,69,96,0.10);
      border: 1px solid rgba(233,69,96,0.15);
      border-radius: 0.8rem;
      padding: 0.6rem 1rem;
      color: #ff6b6b;
      font-size: 0.85rem;
      margin-bottom: 1rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .auth-link {
      color: #e94560;
      text-decoration: none;
      font-weight: 500;
    }
    .auth-link:hover { text-decoration: underline; }
    .back-link {
      color: inherit;
      text-decoration: none;
      opacity: 0.3;
      font-size: 0.8rem;
    }
    .back-link:hover { opacity: 0.6; }
  </style>
</head>
<body>
  <div class="auth-card" id="authCard">
    <div class="auth-title">
      <i class="fa-solid fa-user-plus"></i> สมัครสมาชิก
    </div>
    <div class="auth-sub">สร้างตัวตนใหม่ในโลกดิจิทัล</div>

    <% if (error) { %>
      <div class="error-box"><i class="fa-regular fa-circle-xmark"></i> <%= error %></div>
    <% } %>

    <form action="/auth/register" method="POST">
      <input type="text" name="username" placeholder="ชื่อผู้ใช้ (ใช้ login)" required autofocus>
      <input type="text" name="display_name" placeholder="ชื่อที่แสดง (ถ้าต้องการ)">
      <input type="email" name="email" placeholder="อีเมล (ไม่บังคับ)">
      <input type="password" name="password" placeholder="รหัสผ่าน (อย่างน้อย 6 ตัว)" required>
      <input type="password" name="confirmPassword" placeholder="ยืนยันรหัสผ่าน" required>
      <button type="submit" class="btn-primary"><i class="fa-regular fa-user-plus"></i> สร้างบัญชี</button>
    </form>

    <div style="text-align:center; margin-top:1.2rem; font-size:0.9rem; opacity:0.5;">
      มีบัญชีแล้ว? <a href="/auth/login" class="auth-link">เข้าสู่ระบบ</a>
    </div>
    <div style="text-align:center; margin-top:0.6rem; font-size:0.8rem; opacity:0.25;">
      <a href="/" class="back-link"><i class="fa-regular fa-arrow-left"></i> กลับหน้าแรก</a>
    </div>
  </div>

  <script>
    const card = document.getElementById('authCard');
    if (card) {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width - 0.5;
        const y = (e.clientY - rect.top) / rect.height - 0.5;
        card.style.transform = `rotateX(${y * -4}deg) rotateY(${x * 4}deg)`;
      });
      card.addEventListener('mouseleave', () => {
        card.style.transform = 'rotateX(0deg) rotateY(0deg)';
      });
    }
  </script>
</body>
</html>
