<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <script src="https://cdn.tailwindcss.com"></script>
  
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      background: #0a0a0f;
      color: #f0f0f5;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      min-height: 100vh;
      padding: 2rem 1.5rem;
    }

    .dashboard-container {
      max-width: 820px;
      margin: 0 auto;
      animation: fadeUp 0.6s ease-out both;
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(30px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .card {
      background: rgba(18, 18, 35, 0.82);
      backdrop-filter: blur(16px) saturate(1.4);
      -webkit-backdrop-filter: blur(16px) saturate(1.4);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 1.8rem;
      padding: 1.8rem 2rem;
      margin-bottom: 1.8rem;
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      transform-style: preserve-3d;
      perspective: 600px;
      box-shadow: 0 20px 60px -20px rgba(0,0,0,0.5);
    }

    .card:hover {
      transform: translateY(-4px) scale(1.005);
      box-shadow: 0 30px 80px -20px rgba(0,0,0,0.6);
      border-color: rgba(233,69,96,0.15);
    }

    .card h2 {
      font-size: 1.3rem;
      font-weight: 600;
      margin-bottom: 1.4rem;
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }

    .card h2 .badge {
      font-size: 0.6rem;
      background: rgba(233,69,96,0.18);
      color: #e94560;
      padding: 0.1rem 0.7rem;
      border-radius: 40px;
      font-weight: 500;
      letter-spacing: 0.03em;
    }

    label {
      font-size: 0.8rem;
      opacity: 0.6;
      display: block;
      margin-bottom: 0.25rem;
      font-weight: 500;
      letter-spacing: 0.02em;
    }

    input, select, textarea {
      width: 100%;
      padding: 0.7rem 1.1rem;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 1rem;
      color: #f0f0f5;
      font-size: 0.95rem;
      outline: none;
      transition: all 0.2s ease;
      margin-bottom: 0.8rem;
    }

    input:focus, select:focus, textarea:focus {
      border-color: #e94560;
      box-shadow: 0 0 0 3px rgba(233,69,96,0.08);
    }

    input::placeholder, textarea::placeholder {
      color: rgba(255,255,255,0.2);
    }

    .btn-primary {
      padding: 0.6rem 1.8rem;
      background: #e94560;
      border: none;
      border-radius: 1rem;
      color: #fff;
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
      box-shadow: 0 4px 20px rgba(233,69,96,0.25);
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }

    .btn-primary:hover {
      transform: translateY(-2px) scale(1.02);
      box-shadow: 0 8px 35px rgba(233,69,96,0.35);
    }

    .btn-secondary {
      padding: 0.6rem 1.8rem;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 1rem;
      color: #f0f0f5;
      font-size: 0.9rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.25s ease;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }

    .btn-secondary:hover {
      background: rgba(255,255,255,0.08);
      transform: translateY(-2px);
    }

    .btn-danger {
      padding: 0.4rem 1rem;
      background: rgba(233,69,96,0.12);
      border: 1px solid rgba(233,69,96,0.15);
      border-radius: 0.8rem;
      color: #ff6b6b;
      font-size: 0.8rem;
      cursor: pointer;
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
    }

    .btn-danger:hover {
      background: rgba(233,69,96,0.2);
      transform: scale(1.05);
    }

    .setting-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.7rem 0;
      border-bottom: 1px solid rgba(255,255,255,0.04);
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .setting-item:last-child { border-bottom: none; }

    .setting-info {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      flex: 1;
      min-width: 160px;
    }

    .setting-info .icon {
      font-size: 1.2rem;
      width: 2rem;
      text-align: center;
      color: #e94560;
    }

    .setting-actions {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .edit-form {
      display: none;
      margin-top: 0.8rem;
      padding-top: 0.8rem;
      border-top: 1px solid rgba(255,255,255,0.04);
    }

    .edit-form.active { display: block; }

    .inline-flex {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .inline-flex input, .inline-flex select {
      flex: 1;
      min-width: 90px;
      margin-bottom: 0.5rem;
    }

    .grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.8rem;
    }

    @media (max-width: 600px) {
      .grid-2 { grid-template-columns: 1fr; }
      .dashboard-container { padding: 0 0.5rem; }
      .card { padding: 1.2rem 1rem; border-radius: 1.4rem; }
    }

    .frame-preview {
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 1.2rem;
      background: rgba(0,0,0,0.25);
      border-radius: 1.2rem;
      margin: 0.5rem 0 1.2rem 0;
      perspective: 500px;
    }

    .frame-preview .preview-box {
      width: 90px;
      height: 90px;
      display: flex;
      justify-content: center;
      align-items: center;
      font-size: 2.8rem;
      background: rgba(255,255,255,0.04);
      border: 2.5px solid #e94560;
      transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
      box-shadow: 0 0 30px rgba(233,69,96,0.1);
    }

    .frame-preview .preview-box:hover {
      transform: rotateY(8deg) rotateX(4deg) scale(1.04);
      box-shadow: 0 0 50px rgba(233,69,96,0.2);
    }

    .frame-preview .preview-box.circle { border-radius: 50%; }
    .frame-preview .preview-box.square-rounded { border-radius: 24%; }
    .frame-preview .preview-box.hexagon {
      clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
      border-radius: 0;
      border: 3px solid #e94560;
    }
    .frame-preview .preview-box.none { border: none; background: transparent; box-shadow: none; }

    .success-box {
      background: rgba(46, 213, 115, 0.10);
      border: 1px solid rgba(46, 213, 115, 0.15);
      border-radius: 0.8rem;
      padding: 0.6rem 1rem;
      color: #2ed573;
      font-size: 0.85rem;
      margin-bottom: 1rem;
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }

    .error-box {
      background: rgba(233, 69, 96, 0.10);
      border: 1px solid rgba(233, 69, 96, 0.15);
      border-radius: 0.8rem;
      padding: 0.6rem 1rem;
      color: #ff6b6b;
      font-size: 0.85rem;
      margin-bottom: 1rem;
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }

    ::-webkit-scrollbar { width: 5px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #e94560; border-radius: 10px; }
  </style>
</head>
<body>

  <div class="dashboard-container">

    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 0.5rem;">
      <div>
        <h1 style="font-size: 2.2rem; font-weight: 800; background: linear-gradient(135deg, #e94560, #ff6b6b); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; display: flex; align-items: center; gap: 0.5rem;">
          <i class="fa-solid fa-sliders-h"></i> หลังบ้าน
        </h1>
        <p style="opacity: 0.4; font-size: 0.9rem; display: flex; align-items: center; gap: 0.4rem;">
          <i class="fa-regular fa-user"></i> สวัสดี <%= user?.display_name || user?.username %>
        </p>
      </div>
      <div style="display: flex; gap: 0.7rem; flex-wrap: wrap;">
        <a href="/<%= user?.username %>" class="btn-secondary" style="text-decoration: none;">
          <i class="fa-regular fa-eye"></i> ดู Bio
        </a>
        <a href="/auth/logout" class="btn-danger" style="text-decoration: none;">
          <i class="fa-solid fa-sign-out-alt"></i> ออกจากระบบ
        </a>
      </div>
    </div>

    <% if (success) { %>
      <div class="success-box"><i class="fa-regular fa-circle-check"></i> <%= success %></div>
    <% } %>
    <% if (error) { %>
      <div class="error-box"><i class="fa-regular fa-circle-xmark"></i> <%= error %></div>
    <% } %>

    <div class="card">
      <h2><i class="fa-regular fa-pen-to-square" style="color:#e94560;"></i> ข้อมูล Bio <span class="badge">หัว��้อหลัก</span></h2>
      <form action="/dashboard/update-meta" method="POST">
        <div class="grid-2">
          <div>
            <label><i class="fa-regular fa-signature"></i> ชื่อที่แสดง</label>
            <input type="text" name="logo_text" value="<%= bioMeta?.logo_text || user?.display_name || user?.username %>" placeholder="ชื่อที่แสดง">
          </div>
          <div>
            <label><i class="fa-regular fa-face-smile"></i> อิโมจิโลโก้</label>
            <input type="text" name="logo_emoji" value="<%= bioMeta?.logo_emoji || '🧑' %>" placeholder="🧑">
          </div>
        </div>
        <div>
          <label><i class="fa-regular fa-heading"></i> ชื่อ Bio</label>
          <input type="text" name="bio_title" value="<%= bioMeta?.bio_title || 'Bio ของฉัน' %>" placeholder="ชื่อ Bio">
        </div>
        <div>
          <label><i class="fa-regular fa-message"></i> คำอธิบาย</label>
          <textarea name="bio_description" rows="2" placeholder="เล่าเรื่องตัวเองสั้นๆ"><%= bioMeta?.bio_description || '' %></textarea>
        </div>
        <div class="grid-2">
          <div>
            <label><i class="fa-regular fa-palette"></i> สีหลัก</label>
            <input type="color" name="theme_color" value="<%= bioMeta?.theme_color || '#1a1a2e' %>" style="height: 3rem; padding: 0.25rem;">
          </div>
          <div>
            <label><i class="fa-regular fa-palette"></i> สี Accent</label>
            <input type="color" name="accent_color" value="<%= bioMeta?.accent_color || '#e94560' %>" style="height: 3rem; padding: 0.25rem;">
          </div>
        </div>
        <div>
          <label><i class="fa-regular fa-sun"></i> สไตล์พื้นหลัง</label>
          <select name="bg_style">
            <option value="dark" <%= bioMeta?.bg_style === 'dark' ? 'selected' : '' %>>🌙 Dark</option>
            <option value="light" <%= bioMeta?.bg_style === 'light' ? 'selected' : '' %>>☀️ Light</option>
          </select>
        </div>
        <button type="submit" class="btn-primary"><i class="fa-regular fa-floppy-disk"></i> บันทึก</button>
      </form>
    </div>

    <div class="card">
      <h2><i class="fa-regular fa-image" style="color:#e94560;"></i> ตั้งค่ากรอบโลโก้</h2>
      
      <div class="frame-preview">
        <div class="preview-box 
          <%= bioMeta?.frame_style === 'circle' ? 'circle' : '' %>
          <%= bioMeta?.frame_style === 'square-rounded' ? 'square-rounded' : '' %>
          <%= bioMeta?.frame_style === 'hexagon' ? 'hexagon' : '' %>
          <%= bioMeta?.frame_style === 'none' ? 'none' : '' %>
        " style="
          transform: translate(<%= bioMeta?.frame_x_offset || 0 %>px, <%= bioMeta?.frame_y_offset || 0 %>px) scale(<%= bioMeta?.frame_scale || 1.0 %>);
        ">
          <%= bioMeta?.logo_emoji || '🧑' %>
        </div>
      </div>

      <form action="/dashboard/update-meta" method="POST">
        <div class="grid-2">
          <div>
            <label><i class="fa-regular fa-shapes"></i> สไตล์กรอบ</label>
            <select name="frame_style">
              <option value="circle" <%= bioMeta?.frame_style === 'circle' ? 'selected' : '' %>>วงกลม</option>
              <option value="square-rounded" <%= bioMeta?.frame_style === 'square-rounded' ? 'selected' : '' %>>เหลี่ยมมน</option>
              <option value="hexagon" <%= bioMeta?.frame_style === 'hexagon' ? 'selected' : '' %>>หกเหลี่ยม</option>
              <option value="none" <%= bioMeta?.frame_style === 'none' ? 'selected' : '' %>>ไม่มีกรอบ</option>
            </select>
          </div>
          <div>
            <label><i class="fa-regular fa-expand"></i> Scale</label>
            <input type="number" name="frame_scale" value="<%= bioMeta?.frame_scale || 1.0 %>" step="0.1" min="0.5" max="2.0">
          </div>
        </div>
        <div class="grid-2">
          <div>
            <label><i class="fa-regular fa-arrow-left-right"></i> X Offset</label>
            <input type="number" name="frame_x_offset" value="<%= bioMeta?.frame_x_offset || 0 %>" step="1">
          </div>
          <div>
            <label><i class="fa-regular fa-arrow-up-down"></i> Y Offset</label>
            <input type="number" name="frame_y_offset" value="<%= bioMeta?.frame_y_offset || 0 %>" step="1">
          </div>
        </div>
        <button type="submit" class="btn-primary"><i class="fa-regular fa-floppy-disk"></i> อัปเดตกรอบ</button>
      </form>
    </div>

    <div class="card">
      <h2><i class="fa-regular fa-list" style="color:#e94560;"></i> จัดการรายการ <span class="badge">ลิงก์ / ข้อความ</span></h2>
      
      <form action="/dashboard/add-setting" method="POST" style="margin-bottom: 1.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid rgba(255,255,255,0.04);">
        <div class="grid-2">
          <div>
            <label><i class="fa-regular fa-tag"></i> ชื่อ (key)</label>
            <input type="text" name="key" placeholder="เช่น GitHub, Line" required>
          </div>
          <div>
            <label><i class="fa-regular fa-link"></i> ค่า (value)</label>
            <input type="text" name="value" placeholder="ลิงก์หรือข้อความ" required>
          </div>
        </div>
        <div class="grid-2">
          <div>
            <label><i class="fa-regular fa-icons"></i> ไอคอน (Font Awesome)</label>
            <input type="text" name="icon" placeholder="fa-brands fa-github, fa-regular fa-phone">
          </div>
          <div>
            <label><i class="fa-regular fa-layer-group"></i> ประเภท</label>
            <select name="type">
              <option value="link">🔗 ลิงก์</option>
              <option value="link-icon">🎨 ลิงก์+ไอคอน</option>
              <option value="text">📝 ข้อความ</option>
              <option value="text-icon">✨ ข้อความ+ไอคอน</option>
              <option value="other">อื่นๆ</option>
            </select>
          </div>
        </div>
        <div>
          <label><i class="fa-regular fa-arrow-down-1-9"></i> ลำดับ</label>
          <input type="number" name="display_order" value="0" min="0" step="1">
        </div>
        <button type="submit" class="btn-primary"><i class="fa-regular fa-plus"></i> เพิ่มรายการ</button>
      </form>

      <% if (settings && settings.length > 0) { %>
        <% settings.forEach(item => { %>
          <div class="setting-item">
            <div class="setting-info">
              <span class="icon"><i class="<%= item.icon || 'fa-regular fa-circle' %>"></i></span>
              <span style="font-weight: 500;"><%= item.key %></span>
              <span style="opacity:0.3; font-size:0.7rem;"><%= item.type %></span>
              <span style="opacity:0.5; font-size:0.85rem; word-break:break-all;"><%= item.value %></span>
            </div>
            <div class="setting-actions">
              <button class="btn-secondary" onclick="toggleEdit('<%= item.key %>')" style="font-size:0.75rem; padding:0.25rem 0.8rem;">
                <i class="fa-regular fa-pen"></i>
              </button>
              <form action="/dashboard/delete-setting" method="POST" style="display:inline;" onsubmit="return confirm('ลบ <%= item.key %> จริง?');">
                <input type="hidden" name="key" value="<%= item.key %>">
                <button type="submit" class="btn-danger" style="font-size:0.75rem; padding:0.25rem 0.8rem;">
                  <i class="fa-regular fa-trash-can"></i>
                </button>
              </form>
            </div>
          </div>
          <div id="edit-<%= item.key %>" class="edit-form">
            <form action="/dashboard/edit-setting" method="POST">
              <input type="hidden" name="old_key" value="<%= item.key %>">
              <div class="inline-flex">
                <input type="text" name="key" value="<%= item.key %>" placeholder="ชื่อ" style="flex:1; min-width:80px;">
                <input type="text" name="value" value="<%= item.value %>" placeholder="ค่า" style="flex:1; min-width:80px;">
                <input type="text" name="icon" value="<%= item.icon || '' %>" placeholder="fa-icon" style="flex:0.7; min-width:70px;">
                <select name="type" style="flex:0.5; min-width:80px;">
                  <option value="link" <%= item.type === 'link' ? 'selected' : '' %>>ลิงก์</option>
                  <option value="link-icon" <%= item.type === 'link-icon' ? 'selected' : '' %>>ลิงก์+ไอคอน</option>
                  <option value="text" <%= item.type === 'text' ? 'selected' : '' %>>ข้อความ</option>
                  <option value="text-icon" <%= item.type === 'text-icon' ? 'selected' : '' %>>ข้อความ+ไอคอน</option>
                  <option value="other" <%= item.type === 'other' ? 'selected' : '' %>>อื่นๆ</option>
                </select>
                <input type="number" name="display_order" value="<%= item.display_order || 0 %>" placeholder="ลำดับ" style="flex:0.3; min-width:50px;">
                <button type="submit" class="btn-primary" style="font-size:0.8rem; padding:0.4rem 1rem;">
                  <i class="fa-regular fa-floppy-disk"></i> แก้ไข
                </button>
              </div>
            </form>
          </div>
        <% }) %>
      <% } else { %>
        <p style="opacity:0.3; text-align:center; padding:1.5rem 0;">
          <i class="fa-regular fa-box-open"></i> ยังไม่มีรายการ
        </p>
      <% } %>
    </div>

    <div class="card" style="text-align:center; opacity:0.7;">
      <p style="font-size:0.9rem; display:flex; align-items:center; justify-content:center; gap:0.5rem; flex-wrap:wrap;">
        <i class="fa-regular fa-link"></i> URL Bio ของคุณ:
        <a href="/<%= user?.username %>" style="color:#e94560; text-decoration:none; font-weight:500;" target="_blank">
          <i class="fa-regular fa-arrow-up-right-from-square"></i> /<%= user?.username %>
        </a>
      </p>
      <p style="font-size:0.7rem; opacity:0.3; margin-top:0.3rem;">
        <i class="fa-regular fa-share-nodes"></i> แชร์ลิงก์นี้ให้คนอื่นดู Bio ของคุณ
      </p>
    </div>

  </div>

  <script>
    function toggleEdit(key) {
      const form = document.getElementById('edit-' + key);
      if (form) form.classList.toggle('active');
    }

    document.querySelectorAll('.card').forEach(card => {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width - 0.5;
        const y = (e.clientY - rect.top) / rect.height - 0.5;
        card.style.transform = `rotateX(${y * -3}deg) rotateY(${x * 4}deg) translateY(-4px)`;
      });
      card.addEventListener('mouseleave', () => {
        card.style.transform = 'rotateX(0deg) rotateY(0deg) translateY(0)';
      });
    });
  </script>

</body>
</html>
